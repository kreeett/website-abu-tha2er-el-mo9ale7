{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "rootDir": "ts",
    "outDir": "js",
    "strict": true,
    "removeComments": false,
    "sourceMap": false,
    "moduleDetection": "legacy",
    "module": "esnext"
  },
  "include": ["ts/**/*.ts"]
}
